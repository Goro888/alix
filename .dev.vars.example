# Local development secrets — copy this file to `.dev.vars` and fill in what you have.
# `.dev.vars` is git-ignored. NEVER commit real keys; the Deploy to Cloudflare button
# (or `npm run deploy`) saves them as encrypted Secrets automatically.
# You only need ONE key from ANY company to run the app — add more for automatic failover.

GEMINI_API_KEY=          # Google — free tier: https://aistudio.google.com/apikey
# OPENAI_API_KEY=        # OpenAI (ChatGPT) — sk-...
# ANTHROPIC_API_KEY=     # Claude — sk-ant-...
# GROQ_API_KEY=          # Groq (ultra fast) — gsk_...
# DEEPSEEK_API_KEY=      # DeepSeek — sk-...
# XAI_API_KEY=           # Grok — xai-...
# MISTRAL_API_KEY=       # Mistral
# PERPLEXITY_API_KEY=    # Perplexity — pplx-... (live web search)
# OPENROUTER_API_KEY=    # OpenRouter — sk-or-... (400+ models)
# TOGETHER_API_KEY=      # Together AI
# CEREBRAS_API_KEY=      # Cerebras (fastest inference) — csk-...
# HUGGINGFACE_API_KEY=   # Hugging Face — hf_...
# FIREWORKS_API_KEY=     # Fireworks AI — fw_...

# Optional: password-lock the app (the app asks for the code in Settings)
# ACCESS_CODE=
