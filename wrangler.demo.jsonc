{
  // Local DEMO config — no API key needed, AI answers are fake.
  // Run: npm run dev:demo   (real deploys use wrangler.jsonc)
  "name": "legend-boy-demo",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "vars": { "MOCK_AI": "1", "TTS_SPEAKER": "Puck" }
}
