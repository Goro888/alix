{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Cloudflare only HOSTS the app. The AI runs on your OWN key(s) from almost any
  // AI company — Gemini, OpenAI, Claude, Grok, DeepSeek, Groq, OpenRouter, Mistral,
  // Perplexity, Together, Cerebras, Hugging Face, Fireworks (+ any OpenAI-compatible
  // server). Keys are Secrets (Cloudflare or in-app); these are just model defaults.
  // Your app URL → https://legend-boy.<your-subdomain>.workers.dev
  "name": "alix",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",

  // The phone web app (HTML/CSS/JS/images)
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  "observability": { "enabled": true },

  "vars": {
    // Gemini model for chat, photos, research and voice transcription.
    // "gemini-flash-latest" always uses Google's newest Flash model.
    // Other options: "gemini-3.8-flash", "gemini-3.1-flash-lite", "gemini-2.5-flash"
    "GEMINI_MODEL": "gemini-flash-latest",
    // Voice (text-to-speech) model and default voice
    "GEMINI_TTS_MODEL": "gemini-3.8-flash-lite-tts",
    "TTS_SPEAKER": "Puck",
    // Image creation model ("Nano Banana")
    "GEMINI_IMAGE_MODEL": "gemini-3.1-flash-lite-image"
  }

  // SECRETS — never put them in this file (the repo is public!).
  // Add them in Cloudflare: Worker → Settings → Variables and Secrets → Add → type "Secret"
  //   ANY provider key works: GEMINI_API_KEY, OPENAI_API_KEY, ANTHROPIC_API_KEY, GROQ_API_KEY,
  //   DEEPSEEK_API_KEY, XAI_API_KEY, MISTRAL_API_KEY, PERPLEXITY_API_KEY, OPENROUTER_API_KEY,
  //   TOGETHER_API_KEY, CEREBRAS_API_KEY, HUGGINGFACE_API_KEY, FIREWORKS_API_KEY
  //   ACCESS_CODE     (optional) password-lock the app
  // Keys pasted in the app itself (saved on the phone) work too — no Cloudflare secret needed.
}
